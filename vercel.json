{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/swagger",
      "dest": "/api/swagger.js"
    },
    {
      "src": "/api/docs",
      "dest": "/api/docs.js"
    },
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ]
}